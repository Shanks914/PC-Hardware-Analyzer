<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sadat.pchardware.BuildPanelController" spacing="14" prefWidth="265" minWidth="230" styleClass="panel build-panel">
    <padding><Insets top="20" right="20" bottom="20" left="20" /></padding>
    <children>
        <Label text="PC Builder Quote" styleClass="panel-title" />
        <Label fx:id="activeBuildLabel" text="Unsaved build" styleClass="muted-label" />
        <Label text="ESTIMATED WATTAGE" styleClass="section-label" />
        <Label fx:id="powerLabel" text="0W" styleClass="power-label" />
        <Label text="Approximate estimate" styleClass="muted-label" />
        <Label text="ESTIMATED TOTAL" styleClass="section-label" />
        <Label fx:id="totalLabel" text="৳0" styleClass="total-label" />
        <Label fx:id="buildCountLabel" text="0 parts selected" styleClass="muted-label" />
        <Button fx:id="saveButton" text="Save / Update build" styleClass="button-primary" maxWidth="Infinity" />
        <Button fx:id="loadButton" text="Load saved build" styleClass="button-secondary" maxWidth="Infinity" />
        <Button fx:id="deleteButton" text="Delete saved build" styleClass="button-secondary" maxWidth="Infinity" />
        <Button fx:id="newButton" text="Clear / New build" styleClass="button-secondary" maxWidth="Infinity" />
        <VBox fx:id="buildList" spacing="10" />
    </children>
</VBox>
