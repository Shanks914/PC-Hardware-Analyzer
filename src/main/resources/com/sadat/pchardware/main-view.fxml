<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sadat.pchardware.MainController"
            styleClass="app-root" stylesheets="@app.css">
    <top>
        <fx:include fx:id="header" source="header.fxml" />
    </top>
    <center>
        <StackPane fx:id="pageHost">
            <children>
                <ScrollPane fx:id="builderScroll" fitToWidth="true" pannable="true" styleClass="page-scroll">
                    <content>
                        <HBox fx:id="builderWorkspace" spacing="20" styleClass="workspace">
                            <children>
                                <fx:include fx:id="builder" source="builder.fxml" HBox.hgrow="ALWAYS" />
                                <fx:include fx:id="buildPanel" source="build-panel.fxml" />
                            </children>
                        </HBox>
                    </content>
                </ScrollPane>
                <fx:include fx:id="processorPage" source="processor-page.fxml" />
                <fx:include fx:id="motherboardPage" source="motherboard-page.fxml" />
                <fx:include fx:id="ramPage" source="ram-page.fxml" />
                <fx:include fx:id="ssdPage" source="ssd-page.fxml" />
            </children>
        </StackPane>
    </center>
</BorderPane>
